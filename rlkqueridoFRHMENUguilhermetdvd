local function getAllTargets()
    local targets = {}
    local seen = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            seen[player] = true
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    table.insert(targets, { Kind = "Player", Player = player, Char = char, Humanoid = hum })
                end
            end
        end
    end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local plr = Players:GetPlayerFromCharacter(obj)
            if plr and plr ~= LocalPlayer and not seen[plr] then
                seen[plr] = true
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum then
                    table.insert(targets, { Kind = "Player", Player = plr, Char = obj, Humanoid = hum })
                end
            end
        end
    end

    for _, npc in ipairs(NPCTargets) do
        if npc and npc.Parent then
            local hum = npc:FindFirstChildOfClass("Humanoid")
            if hum then table.insert(targets, { Kind = "NPC", Char = npc, Humanoid = hum }) end
        end
    end
    return targets
end

local function isReallyDead(hum)
    if not hum then return true end
    if hum.Health <= 0 then return true end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    local char = hum.Parent
    if char then
        local head = char:FindFirstChild("Head")
        if head and head.Transparency >= 1 then return true end
    end
    return false
end

local function getAimPart(char)
    if not char then return nil end
    local mode = Config.Aimbot.Humanize
    if mode == "Head" then return char:FindFirstChild("Head")
    elseif mode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    elseif mode == "Pelvis" then
        return char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    end
    return char:FindFirstChild("Head")
end

local function getAimPosition(char, part)
    if not char or not part then return nil end
    if Config.Hitbox.Enabled then
        if part.Name == "Head" and part.Size.Y > 2 then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp.Position + Vector3.new(0, 0.5, 0) end
        end
        if (part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso") and part.Size.Y > 3 then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp.Position end
        end
    end
    return part.Position
end

local function isInvisible(char)
    if not char then return false end
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if head and head.Transparency >= 1 and head.LocalTransparencyModifier >= 1 then
        if torso and torso.Transparency >= 1 and torso.LocalTransparencyModifier >= 1 then return true end
    end
    return false
end

