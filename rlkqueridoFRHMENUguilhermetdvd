local function getBestTarget()
    if not Camera then return nil end
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    if Config.Aimbot.StickyAimbot and Config.Aimbot._stickyTarget then
        local st = Config.Aimbot._stickyTarget
        local char = st.Char
        if char and char.Parent then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and not isReallyDead(hum) then
                if not isWhitelisted(char) and not isTeammate(char, false) then
                    if not (Config.Aimbot.InvisibleCheck and isInvisible(char)) then
                        local part = getAimPart(char)
                        if part and part:IsA("BasePart") then
                            local aimPos = getAimPosition(char, part)
                            local dist = (myRoot.Position - aimPos).Magnitude
                            if dist <= Config.Aimbot.MaxDistance then
                                local sp = Camera:WorldToViewportPoint(aimPos)
                                if sp.Z > 0 then
                                    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                                    local fd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                    if fd <= Config.Aimbot.FOV then
                                        if isVisibleWallCheck(part, char) then return st end
                                    end
                                end
                            end
                        end
                    end
                end
            else Config.Aimbot._stickyTarget = nil end
        else Config.Aimbot._stickyTarget = nil end
    end

    local best = nil; local bestDist = math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, tgt in ipairs(getAllTargets()) do
        local char = tgt.Char
        local hum = tgt.Humanoid or (char and char:FindFirstChildOfClass("Humanoid"))
        if char and hum then
            if not (Config.Aimbot.IgnoreDead and isReallyDead(hum)) then
                local isNPC = (tgt.Kind == "NPC")
                if Config.Aimbot.NPC_Check or not isNPC then
                    if not isWhitelisted(char) and not isTeammate(char, false) then
                        if not (Config.Aimbot.InvisibleCheck and isInvisible(char)) then
                            local part = getAimPart(char)
                            if part and part:IsA("BasePart") then
                                local aimPos = getAimPosition(char, part)
                                local wd = (myRoot.Position - aimPos).Magnitude
                                if wd <= Config.Aimbot.MaxDistance then
                                    if isVisibleWallCheck(part, char) then
                                        local sp = Camera:WorldToViewportPoint(aimPos)
                                        if sp.Z > 0 then
                                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                            if d <= Config.Aimbot.FOV and d < bestDist then
                                                bestDist = d
                                                best = { Kind = tgt.Kind, Player = tgt.Player, Char = char, Humanoid = hum, Part = part, AimPos = aimPos }
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if best and Config.Aimbot.StickyAimbot then Config.Aimbot._stickyTarget = best end
    return best
end

local function shouldAim()
    if not Config.Aimbot.Enabled then return false end
    local mode = Config.Aimbot.HoldMode
    if mode == "Always" then return true end
    if mode == "Toggle" then return Config.Aimbot._toggled end
    if mode == "Hold" then
        if not Config.Aimbot.Keybind then return false end
        local kb = Config.Aimbot.Keybind
        if typeof(kb) == "EnumItem" then
            if kb.EnumType == Enum.KeyCode then return UserInputService:IsKeyDown(kb) end
            if kb.EnumType == Enum.UserInputType then return UserInputService:IsMouseButtonPressed(kb) end
        end
        return false
    end
    return false
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if not Config.Aimbot.Enabled then return end
    if Config.Aimbot.HoldMode ~= "Toggle" then return end
    if not Config.Aimbot.Keybind then return end
    local kb = Config.Aimbot.Keybind
    local match = false
    if typeof(kb) == "EnumItem" then
        if kb.EnumType == Enum.KeyCode and inp.KeyCode == kb then match = true end
        if kb.EnumType == Enum.UserInputType and inp.UserInputType == kb then match = true end
    end
    if match then Config.Aimbot._toggled = not Config.Aimbot._toggled end
end)

