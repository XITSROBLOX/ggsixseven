local hitboxBaseSizes = {}
local hitboxBaseTransparency = {}
local hitboxBaseCanCollide = {}
local hitboxBaseMassless = {}

local function restoreHitboxForChar(char)
    if not char then return end
    for _, partName in ipairs({ "Head", "UpperTorso", "LowerTorso", "Torso" }) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local base = hitboxBaseSizes[part]
            if base then part.Size = base; hitboxBaseSizes[part] = nil end
            local baseT = hitboxBaseTransparency[part]
            if baseT then part.Transparency = baseT; hitboxBaseTransparency[part] = nil end
            local baseC = hitboxBaseCanCollide[part]
            if baseC ~= nil then part.CanCollide = baseC; hitboxBaseCanCollide[part] = nil else part.CanCollide = true end
            local baseM = hitboxBaseMassless[part]
            if baseM ~= nil then part.Massless = baseM; hitboxBaseMassless[part] = nil else part.Massless = false end
        end
    end
end

local function restoreAllHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then restoreHitboxForChar(player.Character) end
    end
end

local function applyHitboxToChar(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local function resize(partName, multiplier)
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if not hitboxBaseSizes[part] then hitboxBaseSizes[part] = part.Size end
            if hitboxBaseCanCollide[part] == nil then hitboxBaseCanCollide[part] = part.CanCollide end
            if hitboxBaseMassless[part] == nil then hitboxBaseMassless[part] = part.Massless end
            part.Size = hitboxBaseSizes[part] * multiplier
            part.CanCollide = false
            part.Massless = true
            if not hitboxBaseTransparency[part] then hitboxBaseTransparency[part] = part.Transparency end
            local t = Config.Hitbox.Transparency / 5
            part.Transparency = math.clamp(hitboxBaseTransparency[part] + t, 0, 1)
        end
    end
    resize("Head", Config.Hitbox.HeadSize)
    resize("UpperTorso", Config.Hitbox.TorsoSize)
    resize("LowerTorso", Config.Hitbox.TorsoSize)
    resize("Torso", Config.Hitbox.TorsoSize)
end

_G.FRH_HitboxLoop = RunService.Heartbeat:Connect(function()
    if not Config.Hitbox.Enabled then
        if next(hitboxBaseSizes) then restoreAllHitboxes() end
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not isWhitelisted(player) and not isTeammate(player, true) then
                applyHitboxToChar(player.Character)
            else
                restoreHitboxForChar(player.Character)
            end
        end
    end
end)

local function onCharAddedHitbox(player)
    return function(char)
        if Config.Hitbox.Enabled then
            task.wait(0.5)
            if Config.Hitbox.Enabled then applyHitboxToChar(char) end
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(onCharAddedHitbox(player))
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(onCharAddedHitbox(player))
    end
end)

