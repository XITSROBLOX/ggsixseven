local AMMO_CFG = { ValorAmmo = 999 }
local weaponOriginalValues = {}

local function isAmmoRelatedName(n)
    n = n:lower()
    return n:find("ammo") or n:find("mag") or n:find("bullet") or n:find("clip") or
           n:find("ammunition") or n:find("round") or n:find("balas") or
           n:find("municao") or n:find("munition") or n:find("maxammo") or
           n:find("stored") or n:find("reserve") or n:find("currentammo") or
           n:find("ammocount") or n:find("ammunitioncount") or n:find("atirar") or
           n:find("tiros") or n:find("munic")
end

local function isRecoilRelatedName(n)
    n = n:lower()
    return n:find("recoil") or n:find("kick") or n:find("recuo") or n:find("camera") or n:find("cam")
end

local function isSpreadRelatedName(n)
    n = n:lower()
    return n:find("spread") or n:find("accuracy") or n:find("dispersion") or n:find("dispersao")
end

local function isFireRateRelatedName(n)
    n = n:lower()
    return n:find("firerate") or n:find("cooldown") or n:find("delay") or n:find("rate") or n:find("cadencia")
end

local function isDamageRelatedName(n)
    n = n:lower()
    return n:find("damage") or n:find("dmg") or n:find("dano")
end

local function refillAmmo(tool)
    if not tool then return end
    for _, child in pairs(tool:GetDescendants()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") then
            if isAmmoRelatedName(child.Name) then
                pcall(function() child.Value = AMMO_CFG.ValorAmmo end)
            end
        end
    end
end

local function applyWeaponMods()
    local char = LocalPlayer.Character
    if not char then return end
    local function processTool(tool)
        if not tool or not tool:IsA("Tool") then return end
        if Config.Weapon.InfiniteAmmo then refillAmmo(tool) end
        for _, obj in pairs(tool:GetDescendants()) do
            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                local n = obj.Name
                if weaponOriginalValues[obj] == nil then weaponOriginalValues[obj] = obj.Value end
                if Config.Weapon.NoRecoil and isRecoilRelatedName(n) then
                    pcall(function() obj.Value = 0 end)
                elseif Config.Weapon.NoSpread and isSpreadRelatedName(n) then
                    pcall(function() obj.Value = 0 end)
                elseif Config.Weapon.FireRate and isFireRateRelatedName(n) then
                    pcall(function() obj.Value = 0.01 end)
                elseif Config.Weapon.DamageBoost and isDamageRelatedName(n) then
                    pcall(function()
                        local orig = weaponOriginalValues[obj] or obj.Value
                        if orig > 0 then obj.Value = orig * 5 end
                    end)
                end
            end
        end
    end
    for _, tool in pairs(char:GetChildren()) do if tool:IsA("Tool") then processTool(tool) end end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then for _, tool in pairs(backpack:GetChildren()) do if tool:IsA("Tool") then processTool(tool) end end end
end

local function restoreAllWeaponValues()
    for obj, orig in pairs(weaponOriginalValues) do
        if obj and obj.Parent then pcall(function() obj.Value = orig end) end
    end
    weaponOriginalValues = {}
end

_G.FRH_AmmoLoop = RunService.Heartbeat:Connect(function()
    if not (Config.Weapon.InfiniteAmmo or Config.Weapon.NoRecoil or Config.Weapon.NoSpread or Config.Weapon.FireRate or Config.Weapon.DamageBoost) then
        if next(weaponOriginalValues) then restoreAllWeaponValues() end
        return
    end
    pcall(applyWeaponMods)
end)

local function setupAutoFire()
    if autoFireConn then autoFireConn:Disconnect(); autoFireConn = nil end
    if Config.Weapon.AutoFire then
        autoFireConn = RunService.RenderStepped:Connect(function()
            if not Config.Weapon.AutoFire then return end
            local char = LocalPlayer.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                if tool:FindFirstChild("Activate") then pcall(function() tool:Activate() end)
                elseif tool:FindFirstChild("Fire") then pcall(function() tool.Fire:FireServer() end)
                elseif tool:FindFirstChild("Shoot") then pcall(function() tool.Shoot:FireServer() end) end
                if tool:FindFirstChild("Click") then pcall(function() tool.Click:FireServer() end) end
            end
        end)
    end
end
