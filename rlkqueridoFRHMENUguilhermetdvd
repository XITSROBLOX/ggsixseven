local function isWhitelisted(c)
    local name
    if typeof(c) == "Instance" then
        if c:IsA("Player") then name = c.Name
        elseif c:IsA("Model") then local p = Players:GetPlayerFromCharacter(c); name = p and p.Name or c.Name end
    end
    if not name then return false end
    return Config.Whitelist.Players[name] == true
end

local function isTeammate(c, forceCheck)
    local checkEnabled
    if forceCheck == true then checkEnabled = Config.Hitbox.TeamCheck
    elseif forceCheck == false then checkEnabled = Config.Aimbot.TeamCheck
    else checkEnabled = Config.Aimbot.TeamCheck end
    if not checkEnabled then return false end
    local player
    if typeof(c) == "Instance" and c:IsA("Player") then player = c
    elseif typeof(c) == "Instance" and c:IsA("Model") then player = Players:GetPlayerFromCharacter(c) end
    if not player or player == LocalPlayer then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return true end
    if LocalPlayer.TeamColor and player.TeamColor and LocalPlayer.TeamColor == player.TeamColor then return true end
    return false
end

local function getPlayerTeamInfo(playerRef, character)
    if not playerRef or not playerRef.Parent then return nil, ESP_Colors.Team end
    local team = playerRef.Team
    if team and team.Name and team.Name ~= "" then
        local col = team.TeamColor and team.TeamColor.Color or ESP_Colors.Team
        return team.Name, col
    end
    if playerRef.TeamColor then
        local col = playerRef.TeamColor.Color
        return tostring(playerRef.TeamColor.Name or "Time"), col
    end
    if character then
        local tag = character:FindFirstChild("Team") or character:FindFirstChild("TeamColor")
        if tag and tag:IsA("StringValue") then return tag.Value, ESP_Colors.Team end
    end
    return nil, ESP_Colors.Team
end

local function isVisibleWallCheck(targetPart, char)
    if not Config.Aimbot.WallCheck then return true end
    if not Camera or not targetPart then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = { myChar, Camera }
    for _, c in ipairs(myChar:GetDescendants()) do
        if c:IsA("BasePart") then table.insert(exclude, c) end
    end
    if char then
        for _, c in ipairs(char:GetDescendants()) do
            if c:IsA("BasePart") then table.insert(exclude, c) end
        end
    end
    rp.FilterDescendantsInstances = exclude
    local rr = Workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, rp)
    if not rr then return true end
    if char and rr.Instance:IsDescendantOf(char) then return true end
    return false
end

