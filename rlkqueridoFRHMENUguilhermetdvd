        ESP_Colors.Skeleton = newColor
        ESP_Colors.FaceCircle = newColor
        for _, cb in ipairs(ColorUpdateCallbacks) do
            pcall(cb, "Skeleton", newColor); pcall(cb, "FaceCircle", newColor)
        end
    end
    for _, cb in ipairs(ColorUpdateCallbacks) do pcall(cb, colorKey, newColor) end
