local function applyNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if noclipPartsCache[part] == nil then noclipPartsCache[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end

local function removeNoclip()
    for part, orig in pairs(noclipPartsCache) do if part and part.Parent then pcall(function() part.CanCollide = orig end) end end
    noclipPartsCache = {}
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local bodyParts = {Head=true,Torso=true,UpperTorso=true,LowerTorso=true,HumanoidRootPart=true,LeftUpperArm=true,RightUpperArm=true,LeftLowerArm=true,RightLowerArm=true,LeftHand=true,RightHand=true,LeftUpperLeg=true,RightUpperLeg=true,LeftLowerLeg=true,RightLowerLeg=true,LeftFoot=true,RightFoot=true}
                if bodyParts[part.Name] then pcall(function() part.CanCollide = true end) end
            end
        end
    end
end

_G.FRH_NoclipLoop = RunService.Stepped:Connect(function()
    if Config.Player.NoclipEnabled then
        if not noclipActive then noclipActive = true; noclipPartsCache = {} end
        applyNoclip()
    else
        if noclipActive then noclipActive = false; removeNoclip() end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    noclipPartsCache = {}
    if Config.Player.NoclipEnabled then task.wait(0.5); applyNoclip() end
end)

