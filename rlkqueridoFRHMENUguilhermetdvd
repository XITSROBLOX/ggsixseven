local function findBestCharacterPart(char)
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.RootPart and hum.RootPart.Parent then return hum.RootPart end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    local candidates = { "UpperTorso", "LowerTorso", "Torso", "Head" }
    for _, name in ipairs(candidates) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    if char.PrimaryPart then return char.PrimaryPart end
    for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then return d end end
    return nil
end

local function waitForCharacter(player, timeout)
    timeout = timeout or 4
    local t0 = tick()
    while tick() - t0 < timeout do
        if player.Character then
            local part = findBestCharacterPart(player.Character)
            if part then return part end
        end
        task.wait(0.1)
    end
    return nil
end

function teleportToPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false, "Invalido" end
    local myChar = LocalPlayer.Character
    if not myChar then return false, "Voce nao tem personagem" end
    local targetPart = waitForCharacter(targetPlayer, 4)
    if not targetPart then return false, "Alvo sem BasePart" end
    saveCurrentPosition()
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false, "Voce sem HumanoidRootPart" end
    local targetPos = targetPart.Position + Vector3.new(0, 3, 0)
    local ok = pcall(function() myChar:PivotTo(CFrame.new(targetPos)) end)
    if not ok then pcall(function() myHrp.CFrame = CFrame.new(targetPos) end) end
    pcall(function()
        myHrp.Velocity = Vector3.new(0, 0, 0)
        myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)
    return true, "OK"
end

function spectatePlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false, "Invalido" end
    local tgtPart = waitForCharacter(targetPlayer, 4)
    if not tgtPart then
        local tgtChar = targetPlayer.Character
        if tgtChar then
            local hum = tgtChar:FindFirstChildOfClass("Humanoid")
            if hum then tgtPart = hum end
        end
    end
    if not tgtPart then return false, "Alvo sem parte valida" end
    SpectateTarget = targetPlayer
    if Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject = tgtPart end
    return true, "OK"
end

