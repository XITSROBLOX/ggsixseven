local R15_Bones = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
}
local R6_Bones = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

local function processChar(esp, character, humanoid, rootPart, head, playerRef, nameOverride, myRoot)
    if not esp or not character or not humanoid or not rootPart or not head then HideAllESPObjects(esp); return end
    if humanoid.Health <= 0 then HideAllESPObjects(esp); return end

    local needsRebuild = false
    if not esp.Billboard or not esp.Billboard.Parent then needsRebuild = true
    elseif not esp.Billboard:FindFirstChild("Container") then needsRebuild = true
    elseif esp.Billboard.Adornee ~= head and esp.Billboard.Adornee ~= rootPart then needsRebuild = true end
    if needsRebuild then
        if esp.Billboard then pcall(function() esp.Billboard:Destroy() end) end
        local playerName = playerRef and playerRef.Name or (nameOverride or character.Name)
        local bb, tt, bt, tm, wp = createBillboardFor(playerName, character)
        esp.Billboard = bb; esp.TopText = tt; esp.BotText = bt; esp.TeamText = tm; esp.WeaponText = wp
    end

    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    if headPos.Z <= 0 then HideAllESPObjects(esp); return end
    local rootPos = Camera:WorldToViewportPoint(rootPart.Position)
    if rootPos.Z <= 0 then HideAllESPObjects(esp); return end

    local distToMe = myRoot and (myRoot.Position - rootPart.Position).Magnitude or 0
    if myRoot and distToMe > Config.Visuals.ESPMaxDistance then HideAllESPObjects(esp); return end

    local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 2.5, 0))
    local boxTopY = headPos.Y
    local boxBottomY = legPos.Y
    local boxHeight = math.abs(boxBottomY - boxTopY) + 10
    if boxHeight < 5 then boxHeight = 5 end
    local boxWidth = boxHeight * 0.90
    local boxCenterX = headPos.X
    local boxLeft = boxCenterX - (boxWidth / 2)

    if ESP_Settings.ESP_Box then
        if ESP_Settings.ESP_3D_Mode == "Box" then
            esp.BoxOutline.Visible = true
            esp.BoxOutline.Size = Vector2.new(math.floor(boxWidth), math.floor(boxHeight))
            esp.BoxOutline.Position = Vector2.new(math.floor(boxLeft), math.floor(boxTopY))
            esp.Box.Visible = true
            esp.Box.Size = Vector2.new(math.floor(boxWidth), math.floor(boxHeight))
            esp.Box.Position = Vector2.new(math.floor(boxLeft), math.floor(boxTopY))
            esp.CornerTL_H.Visible = false; esp.CornerTL_V.Visible = false
            esp.CornerTR_H.Visible = false; esp.CornerTR_V.Visible = false
            esp.CornerBL_H.Visible = false; esp.CornerBL_V.Visible = false
            esp.CornerBR_H.Visible = false; esp.CornerBR_V.Visible = false
        else
            esp.BoxOutline.Visible = false; esp.Box.Visible = false
            local cL = math.floor(boxHeight * 0.10)
            local x1 = math.floor(boxLeft); local y1 = math.floor(boxTopY)
            local x2 = math.floor(boxLeft + boxWidth); local y2 = math.floor(boxTopY + boxHeight)
            esp.CornerTL_H.From = Vector2.new(x1, y1); esp.CornerTL_H.To = Vector2.new(x1 + cL, y1)
            esp.CornerTL_V.From = Vector2.new(x1, y1); esp.CornerTL_V.To = Vector2.new(x1, y1 + cL)
            esp.CornerTR_H.From = Vector2.new(x2 - cL, y1); esp.CornerTR_H.To = Vector2.new(x2, y1)
            esp.CornerTR_V.From = Vector2.new(x2, y1); esp.CornerTR_V.To = Vector2.new(x2, y1 + cL)
            esp.CornerBL_H.From = Vector2.new(x1, y2); esp.CornerBL_H.To = Vector2.new(x1 + cL, y2)
            esp.CornerBL_V.From = Vector2.new(x1, y2 - cL); esp.CornerBL_V.To = Vector2.new(x1, y2)
            esp.CornerBR_H.From = Vector2.new(x2 - cL, y2); esp.CornerBR_H.To = Vector2.new(x2, y2)
            esp.CornerBR_V.From = Vector2.new(x2, y2 - cL); esp.CornerBR_V.To = Vector2.new(x2, y2)
            esp.CornerTL_H.Visible = true; esp.CornerTL_V.Visible = true
            esp.CornerTR_H.Visible = true; esp.CornerTR_V.Visible = true
            esp.CornerBL_H.Visible = true; esp.CornerBL_V.Visible = true
            esp.CornerBR_H.Visible = true; esp.CornerBR_V.Visible = true
        end
    else
        esp.BoxOutline.Visible = false; esp.Box.Visible = false
        esp.CornerTL_H.Visible = false; esp.CornerTL_V.Visible = false
        esp.CornerTR_H.Visible = false; esp.CornerTR_V.Visible = false
        esp.CornerBL_H.Visible = false; esp.CornerBL_V.Visible = false
        esp.CornerBR_H.Visible = false; esp.CornerBR_V.Visible = false
    end

    -- ✅ FIX v90: Billboard proporcional à caixa ESP (mesmo tamanho/escala)
    if esp.Billboard then
        local showName = ESP_Settings.ESP_Draw_Name
        local showBot = ESP_Settings.ESP_Draw_Distance
        local showTeam = playerRef and ESP_Settings.ESP_Team
        local showWeapon = playerRef and ESP_Settings.ESP_Weapon
        local showAnyText = showName or showBot or showTeam

        -- Alinha Billboard ao topo da cabeça
        esp.Billboard.Adornee = head
        local headSize = head.Size.Y
        esp.Billboard.StudsOffset = Vector3.new(0, headSize / 2 + 0.3, 0)
        -- A Billboard tem TAMANHO em pixels (não studs), então usamos a caixa Drawing
        esp.Billboard.Size = UDim2.new(0, math.floor(boxWidth), 0, math.floor(boxHeight))

        if not showAnyText and not showWeapon then
            if esp.TopText then esp.TopText.Visible = false; esp.TopText.Text = "" end
            if esp.BotText then esp.BotText.Visible = false; esp.BotText.Text = "" end
            if esp.TeamText then esp.TeamText.Visible = false; esp.TeamText.Text = "" end
            if esp.WeaponText then esp.WeaponText.Visible = false; esp.WeaponText.Text = "" end
            esp.Billboard.Enabled = false
        else
            esp.Billboard.Enabled = true
            local container = esp.Billboard:FindFirstChild("Container")
            local caixa = container and container:FindFirstChild("Caixa")
            if caixa then caixa.Visible = true end

            -- ✅ TextSize escala com a altura da caixa ESP (proporcional por distância)
            local scaledText = math.clamp(math.floor(boxHeight * 0.16), 6, 16)
            local scaledSmall = math.clamp(math.floor(boxHeight * 0.13), 6, 14)

            if esp.TopText then
                if showName then
                    esp.TopText.Visible = true
                    esp.TopText.Text = nameOverride or (playerRef and playerRef.Name) or character.Name
                    esp.TopText.TextSize = scaledText
                else esp.TopText.Visible = false; esp.TopText.Text = "" end
            end
            if esp.BotText then
                if showBot then
                    esp.BotText.Visible = true
                    esp.BotText.Text = string.format("%.0fm", distToMe)
                    esp.BotText.TextSize = scaledSmall
                else esp.BotText.Visible = false; esp.BotText.Text = "" end
            end
            if esp.TeamText then
                if showTeam then
                    local teamName, teamColor = getPlayerTeamInfo(playerRef, character)
                    if teamName and teamName ~= "" then
                        esp.TeamText.Visible = true
                        esp.TeamText.Text = "[" .. teamName .. "]"
                        esp.TeamText.TextColor3 = teamColor or ESP_Colors.Team
                        esp.TeamText.TextSize = scaledSmall
                    else esp.TeamText.Visible = false; esp.TeamText.Text = "" end
                else esp.TeamText.Visible = false; esp.TeamText.Text = "" end
            end
            if esp.WeaponText then
                if showWeapon then
                    local wname = WeaponCache[playerRef] or ""
                    if wname ~= "" then
                        esp.WeaponText.Visible = true
                        esp.WeaponText.TextColor3 = ESP_Colors.Weapon
                        esp.WeaponText.Text = wname
                        esp.WeaponText.TextSize = scaledSmall
                    else esp.WeaponText.Visible = false; esp.WeaponText.Text = "" end
                else esp.WeaponText.Visible = false; esp.WeaponText.Text = "" end
            end
        end
    end

    if ESP_Settings.ESP_Snapline then
        esp.Snapline.Visible = true
        esp.Snapline.From = Vector2.new(math.floor(Camera.ViewportSize.X / 2), Camera.ViewportSize.Y)
        esp.Snapline.To = Vector2.new(math.floor(legPos.X), math.floor(legPos.Y))
    else esp.Snapline.Visible = false end

    if ESP_Settings.ESP_Face_Circle then
        esp.FaceCircle.Visible = true
        esp.FaceCircle.Color = ESP_Colors.Box
        local dc = (Camera.CFrame.Position - head.Position).Magnitude
        esp.FaceCircle.Radius = math.clamp(50 / dc, 1, 5)
        local hp = Camera:WorldToViewportPoint(head.Position)
        esp.FaceCircle.Position = Vector2.new(math.floor(hp.X), math.floor(hp.Y))
    else esp.FaceCircle.Visible = false end

    if ESP_Settings.Health_Bar then
        esp.HealthBg.Visible = true; esp.HealthBar.Visible = true
        local hp = humanoid.Health / humanoid.MaxHealth
        local bx = math.floor(boxLeft) - 8
        esp.HealthBg.From = Vector2.new(bx, math.floor(boxTopY))
        esp.HealthBg.To = Vector2.new(bx, math.floor(boxTopY + boxHeight))
        esp.HealthBar.From = Vector2.new(bx, math.floor(boxTopY + boxHeight))
        esp.HealthBar.To = Vector2.new(bx, math.floor(boxTopY + boxHeight - (boxHeight * hp)))
    else esp.HealthBg.Visible = false; esp.HealthBar.Visible = false end

    if ESP_Settings.ESP_Skeleton then
        local isR15 = character:FindFirstChild("UpperTorso") ~= nil
        local bs = isR15 and R15_Bones or R6_Bones
        for i = 1, 14 do
            local bp = bs[i]
            if bp then
                local p1 = character:FindFirstChild(bp[1])
                local p2 = character:FindFirstChild(bp[2])
                if p1 and p2 then
                    local pos1 = Camera:WorldToViewportPoint(p1.Position)
                    local pos2 = Camera:WorldToViewportPoint(p2.Position)
                    if pos1.Z > 0 and pos2.Z > 0 then
                        esp.Skeleton[i].Visible = true
                        esp.Skeleton[i].Color = ESP_Colors.Box
                        esp.Skeleton[i].From = Vector2.new(math.floor(pos1.X), math.floor(pos1.Y))
                        esp.Skeleton[i].To = Vector2.new(math.floor(pos2.X), math.floor(pos2.Y))
                    else esp.Skeleton[i].Visible = false end
                else esp.Skeleton[i].Visible = false end
            else esp.Skeleton[i].Visible = false end
        end
    else for i = 1, 14 do if esp.Skeleton[i] then esp.Skeleton[i].Visible = false end end end
end

_G.FRH_ESPLoop = RunService.RenderStepped:Connect(function(dt)
    ESP_Throttle.frameCounter = ESP_Throttle.frameCounter + 1
    ESP_Throttle.avgFrameTime = ESP_Throttle.avgFrameTime * 0.9 + dt * 0.1
    local interval = ESP_Throttle.interval
    if IS_RIVALS and ESP_Throttle.avgFrameTime > 0.033 then
        interval = 4; ESP_Throttle.lagDetected = true
    elseif ESP_Throttle.avgFrameTime < 0.02 then
        interval = IS_RIVALS and 2 or 1; ESP_Throttle.lagDetected = false
    end
    if ESP_Throttle.frameCounter % interval ~= 0 then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for player, esp in pairs(ESP_Cache) do
        if not ESP_Settings.ESP_Enable then HideAllESPObjects(esp)
        else
            local character = player.Character
            local humanoid = character and character:FindFirstChild("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local head = character and character:FindFirstChild("Head")
            processChar(esp, character, humanoid, rootPart, head, player, nil, myRoot)
        end
    end

    if ESP_Settings.ESP_Enable and ESP_Settings.NPC_Check then
        for _, npc in ipairs(NPCTargets) do
            if npc and npc.Parent then
                if not NPC_Cache[npc] then CreateNPCESP(npc) end
                local esp = NPC_Cache[npc]
                if esp then
                    local hum = npc:FindFirstChildOfClass("Humanoid")
                    local rp = npc:FindFirstChild("HumanoidRootPart")
                    local hd = npc:FindFirstChild("Head")
                    if hum and rp and hd then processChar(esp, npc, hum, rp, hd, nil, npc.Name, myRoot)
                    else HideAllESPObjects(esp) end
                end
            end
        end
        for npc, _ in pairs(NPC_Cache) do if not npc.Parent then RemoveNPCESP(npc) end end
    else
        for npc, esp in pairs(NPC_Cache) do HideAllESPObjects(esp) end
    end
end)
