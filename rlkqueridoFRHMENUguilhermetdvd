local CF = "FRH_Configs"
local hfa = type(isfolder) == "function" and type(makefolder) == "function" and type(isfile) == "function" and type(writefile) == "function" and type(readfile) == "function" and type(delfile) == "function" and type(listfiles) == "function"
local function ECF() if not hfa then return false, "Executor nao suporta." end; if not isfolder(CF) then makefolder(CF) end; return true end
local function GCP(n) return CF .. "/" .. n .. ".json" end

local function SaveConfig(n, ow)
    local ok, e = ECF(); if not ok then return false, e end
    local p = GCP(n)
    if isfile(p) and not ow then return false, "Ja existe!" end
    local toSave = { Interface = Config.Interface, Matcha = Config.Matcha, Aimbot = Config.Aimbot, Visuals = Config.Visuals, World = Config.World, Hitbox = Config.Hitbox, ESP = ESP_Settings, Colors = ESP_Colors, Whitelist = Config.Whitelist, Player = Config.Player, Weapon = Config.Weapon, PuxarArmas = Config.PuxarArmas }
    writefile(p, HttpService:JSONEncode(serializeValue(toSave)))
    return true, "Salvo!"
end

local function LoadConfig(n)
    local ok, e = ECF(); if not ok then return false, e end
    local p = GCP(n)
    if not isfile(p) then return false, "Nao encontrado!" end
    local data, err = pcall(function() return HttpService:JSONDecode(readfile(p)) end)
    if not data then return false, "Erro: " .. tostring(err) end
    local d = deserializeValue(data)
    if d.ESP then deepMerge(ESP_Settings, d.ESP) end
    if d.Colors then deepMerge(ESP_Colors, d.Colors) end
    if d.Interface then deepMerge(Config.Interface, d.Interface) end
    if d.Matcha then deepMerge(Config.Matcha, d.Matcha) end
    if d.Aimbot then deepMerge(Config.Aimbot, d.Aimbot) end
    if d.Visuals then deepMerge(Config.Visuals, d.Visuals) end
    if d.World then deepMerge(Config.World, d.World) end
    if d.Hitbox then deepMerge(Config.Hitbox, d.Hitbox) end
    if d.Whitelist then deepMerge(Config.Whitelist, d.Whitelist) end
    if d.Player then deepMerge(Config.Player, d.Player) end
    if d.Weapon then deepMerge(Config.Weapon, d.Weapon) end
    if d.PuxarArmas then deepMerge(Config.PuxarArmas, d.PuxarArmas) end
    for k, v in pairs(ESP_Colors) do
        for _, cb in ipairs(ColorUpdateCallbacks) do pcall(cb, k, v) end
    end
    for _, esp in pairs(ESP_Cache) do if esp._ApplyColors then pcall(esp._ApplyColors) end end
    if updateCrosshair then updateCrosshair() end
    return true, "Carregado!"
end

local function DeleteConfig(n)
    local ok, e = ECF(); if not ok then return false, e end
    local p = GCP(n)
    if not isfile(p) then return false, "Nao encontrado!" end
    delfile(p); return true, "Excluido!"
end

