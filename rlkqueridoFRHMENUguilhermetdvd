local function clearCrosshairParts()
    for _, p in ipairs(CrosshairParts) do pcall(function() p:Destroy() end) end
    CrosshairParts = {}
end

local function makeCrossPart(parent, sx, sy, px, py, color)
    local p = Instance.new("Frame")
    p.Size = UDim2.new(0, sx, 0, sy); p.Position = UDim2.new(0.5, px, 0.5, py)
    p.AnchorPoint = Vector2.new(0.5, 0.5); p.BackgroundColor3 = color
    p.BorderSizePixel = 0; p.ZIndex = 11; p.Parent = parent
    table.insert(CrosshairParts, p); return p
end

local function updateCrosshair()
    clearCrosshairParts()
    if not Config.Weapon.CrosshairEnabled or Config.Weapon.CrosshairSelected == "Nenhum" then return end
    local sel = Config.Weapon.CrosshairSelected
    local size = Config.Weapon.CrosshairSize
    local color = Config.Weapon.CrosshairColors[sel] or Color3.fromRGB(255, 255, 255)
    local scale = size / 24

    if sel == "CROSSHAIR 1" then
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, math.max(4, 6*scale), 0, math.max(4, 6*scale))
        dot.Position = UDim2.new(0.5, 0, 0.5, 0); dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.BackgroundColor3 = color; dot.BorderSizePixel = 0; dot.ZIndex = 11; dot.Parent = CrosshairContainer
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
        table.insert(CrosshairParts, dot)
    elseif sel == "CROSSHAIR 2" then
        local t = 2; local g = 4 * scale; local sz = size
        makeCrossPart(CrosshairContainer, sz, t, -(sz/2 + g), 0, color)
        makeCrossPart(CrosshairContainer, sz, t, (sz/2 + g), 0, color)
        makeCrossPart(CrosshairContainer, t, sz, 0, -(sz/2 + g), color)
        makeCrossPart(CrosshairContainer, t, sz, 0, (sz/2 + g), color)
        makeCrossPart(CrosshairContainer, t+2, t+2, 0, 0, color)
    elseif sel == "CROSSHAIR 3" then
        local t = 2; local arm = 24 * scale; local legLen = 20 * scale
        makeCrossPart(CrosshairContainer, arm, t, 0, -legLen, color)
        makeCrossPart(CrosshairContainer, t, legLen + t, 0, -(legLen/2), color)
    elseif sel == "CROSSHAIR 4" then
        local circle = Instance.new("Frame")
        circle.Size = UDim2.new(0, size, 0, size); circle.Position = UDim2.new(0.5, 0, 0.5, 0)
        circle.AnchorPoint = Vector2.new(0.5, 0.5); circle.BackgroundTransparency = 1
        circle.ZIndex = 11; circle.Parent = CrosshairContainer
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
        local s = Instance.new("UIStroke", circle); s.Color = color; s.Thickness = 2
        table.insert(CrosshairParts, circle)
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 4, 0, 4); dot.Position = UDim2.new(0.5, 0, 0.5, 0)
        dot.AnchorPoint = Vector2.new(0.5, 0.5); dot.BackgroundColor3 = color; dot.BorderSizePixel = 0; dot.ZIndex = 11
        dot.Parent = CrosshairContainer
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
        table.insert(CrosshairParts, dot)
    end
end
