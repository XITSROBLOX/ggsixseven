local flingCooldown = 0
local FLING_COOLDOWN_TIME = 0.6
local flingEmAndamento = false
local FPDH = Workspace.FallenPartsDestroyHeight

local function getFlingForce() return Config.Player.FlingForce or 500 end

local function SkidFling(TargetPlayer)
    local OldPos = nil
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return end
    local THumanoid, TRootPart, THead, Accessory, Handle
    if TCharacter:FindFirstChildOfClass("Humanoid") then THumanoid = TCharacter:FindFirstChildOfClass("Humanoid") end
    if THumanoid and THumanoid.RootPart then TRootPart = THumanoid.RootPart end
    if TCharacter:FindFirstChild("Head") then THead = TCharacter.Head end
    if TCharacter:FindFirstChildOfClass("Accessory") then Accessory = TCharacter:FindFirstChildOfClass("Accessory") end
    if Accessory and Accessory:FindFirstChild("Handle") then Handle = Accessory.Handle end
    if Character and Humanoid and RootPart then
        if RootPart.Velocity.Magnitude < 50 then OldPos = RootPart.CFrame end
        if THumanoid and THumanoid.Sit then return end
        if THead then Workspace.CurrentCamera.CameraSubject = THead
        elseif Handle then Workspace.CurrentCamera.CameraSubject = Handle
        elseif THumanoid and TRootPart then Workspace.CurrentCamera.CameraSubject = THumanoid end
        if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end
        local FPos = function(BasePart, Pos, Ang)
            RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
            Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
            RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end
        local force = getFlingForce()
        local SFBasePart = function(BasePart)
            local TimeToWait = math.clamp(force / 500, 0.5, 3)
            local Time = tick()
            local Angle = 0
            repeat
                if RootPart and THumanoid then
                    if BasePart.Velocity.Magnitude < 50 then
                        Angle = Angle + 100
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle),0 ,0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle),0 ,0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle),0 ,0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                    else
                        FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                        task.wait()
                    end
                end
            until Time + TimeToWait < tick() or not Config.Player.FlingEnabled
        end
        Workspace.FallenPartsDestroyHeight = 0/0
        local BV = Instance.new("BodyVelocity")
        BV.Parent = RootPart
        BV.Velocity = Vector3.new(0, 0, 0)
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        if TRootPart then SFBasePart(TRootPart)
        elseif THead then SFBasePart(THead)
        elseif Handle then SFBasePart(Handle)
        else return end
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        Workspace.CurrentCamera.CameraSubject = Humanoid
        if OldPos then
            local timeout = tick() + 3
            repeat
                RootPart.CFrame = OldPos * CFrame.new(0, .5, 0)
                Character:SetPrimaryPartCFrame(OldPos * CFrame.new(0, .5, 0))
                Humanoid:ChangeState("GettingUp")
                for _, part in pairs(Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                    end
                end
                task.wait()
            until (RootPart.Position - OldPos.p).Magnitude < 25 or tick() > timeout
            Workspace.FallenPartsDestroyHeight = FPDH
        end
    end
end

_G.FRH_FlingConn = nil
_G.FRH_FlingHeartbeat = nil

local function refreshFlingConnection(character)
    if _G.FRH_FlingConn then pcall(function() _G.FRH_FlingConn:Disconnect() end); _G.FRH_FlingConn = nil end
    if _G.FRH_FlingHeartbeat then pcall(function() _G.FRH_FlingHeartbeat:Disconnect() end); _G.FRH_FlingHeartbeat = nil end
    if not Config.Player.FlingEnabled or not character then return end
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    _G.FRH_FlingConn = hrp.Touched:Connect(function(hit)
        if not Config.Player.FlingEnabled then return end
        if flingEmAndamento then return end
        local agora = tick()
        if (agora - flingCooldown) < FLING_COOLDOWN_TIME then return end
        local outroChar = hit:FindFirstAncestorOfClass("Model")
        if not outroChar or outroChar == character then return end
        local outroHum = outroChar:FindFirstChildOfClass("Humanoid")
        if not outroHum or outroHum.Health <= 0 then return end
        local outroPlayer = Players:GetPlayerFromCharacter(outroChar)
        if not outroPlayer or outroPlayer == LocalPlayer then return end
        flingCooldown = agora
        flingEmAndamento = true
        task.spawn(function()
            pcall(SkidFling, outroPlayer)
            flingEmAndamento = false
        end)
    end)

    _G.FRH_FlingHeartbeat = RunService.Heartbeat:Connect(function()
        if not Config.Player.FlingEnabled then return end
        if flingEmAndamento then return end
        local agora = tick()
        if (agora - flingCooldown) < FLING_COOLDOWN_TIME then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local closestPlayer = nil
        local closestDist = 6
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= LocalPlayer and other.Character then
                local oRoot = other.Character:FindFirstChild("HumanoidRootPart")
                local oHum = other.Character:FindFirstChildOfClass("Humanoid")
                if oRoot and oHum and oHum.Health > 0 then
                    local d = (myRoot.Position - oRoot.Position).Magnitude
                    if d < closestDist then
                        closestDist = d
                        closestPlayer = other
                    end
                end
            end
        end

        if closestPlayer then
            flingCooldown = agora
            flingEmAndamento = true
            task.spawn(function()
                pcall(SkidFling, closestPlayer)
                flingEmAndamento = false
            end)
        end
    end)
end

_G.FRH_RefreshFlingConn = refreshFlingConnection
LocalPlayer.CharacterAdded:Connect(function(char) task.wait(0.3); refreshFlingConnection(char) end)

local function NotifyColorChange(colorKey, newColor)
    ESP_Colors[colorKey] = newColor
