-- AIMBOT RENDER STEP
local AIMBOT_RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 10
local function FRH_AimbotRenderStep(dt)
    Camera = Workspace.CurrentCamera
    if not Camera then return end
    local cam = Camera
    if Config.Aimbot.Enabled and shouldAim() then
        local target = getBestTarget()
        if target and target.Part and target.Part.Parent then
            local aimPos = target.AimPos
            if not aimPos then aimPos = getAimPosition(target.Char, target.Part) or target.Part.Position end
            if Config.Aimbot.Aimlock then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPos)
            else
                local goal = CFrame.lookAt(cam.CFrame.Position, aimPos)
                local smoothing = math.clamp(Config.Aimbot.Smoothing, 0.01, 1)
                cam.CFrame = cam.CFrame:Lerp(goal, smoothing)
            end
        end
    end
end
pcall(function() RunService:UnbindFromRenderStep("FRH_AimbotRender") end)
RunService:BindToRenderStep("FRH_AimbotRender", AIMBOT_RENDER_PRIORITY, FRH_AimbotRenderStep)

