local function createFOVCircles()
    if FOVCircleOuter then FOVCircleOuter:Remove(); FOVCircleOuter = nil end
    if FOVCircleInner then FOVCircleInner:Remove(); FOVCircleInner = nil end
    if not Drawing then return end
    FOVCircleOuter = Drawing.new("Circle"); FOVCircleOuter.Thickness = 3; FOVCircleOuter.NumSides = 64; FOVCircleOuter.Radius = Config.Aimbot.FOV
    FOVCircleOuter.Filled = false; FOVCircleOuter.Transparency = 1; FOVCircleOuter.Color = C.FOV_OUTER; FOVCircleOuter.Visible = false
    FOVCircleInner = Drawing.new("Circle"); FOVCircleInner.Thickness = 1.5; FOVCircleInner.NumSides = 64; FOVCircleInner.Radius = Config.Aimbot.FOV
    FOVCircleInner.Filled = false; FOVCircleInner.Transparency = 1; FOVCircleInner.Color = C.FOV_INNER; FOVCircleInner.Visible = false
end

_G.FRH_FovLoop = RunService.RenderStepped:Connect(function()
    if not Camera then return end
    if Config.Aimbot.DrawFOV then
        if not FOVCircleOuter or not FOVCircleInner then createFOVCircles() end
        if FOVCircleOuter and FOVCircleInner then
            FOVCircleInner.Radius = Config.Aimbot.FOV
            FOVCircleOuter.Radius = Config.Aimbot.FOV
            local pos
            if Config.Aimbot.HoldMode == "Always" then
                pos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            else
                pos = UserInputService:GetMouseLocation()
            end
            FOVCircleOuter.Position = pos; FOVCircleOuter.Color = C.FOV_OUTER; FOVCircleOuter.Visible = true
            FOVCircleInner.Position = pos; FOVCircleInner.Color = C.FOV_INNER; FOVCircleInner.Visible = true
        end
    else
        if FOVCircleOuter then FOVCircleOuter.Visible = false end
        if FOVCircleInner then FOVCircleInner.Visible = false end
    end
end)

-- MATCHA
local matchaDragging = false; local matchaDragStart = nil; local matchaStartPos = nil
local function createMatchaFrame()
    MatchaFrame = Instance.new("Frame")
    MatchaFrame.Name = "FRH_Matcha"
    MatchaFrame.Size = UDim2.new(0, 300, 0, 50)
    MatchaFrame.Position = UDim2.new(0.5, -150, 0, 10)
    MatchaFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22); MatchaFrame.BackgroundTransparency = 0.15
    MatchaFrame.BorderSizePixel = 0; MatchaFrame.ZIndex = 200; MatchaFrame.Active = true; MatchaFrame.Visible = true; MatchaFrame.Parent = ScreenGui
    Instance.new("UICorner", MatchaFrame).CornerRadius = UDim.new(0, 6)
    local str = Instance.new("UIStroke", MatchaFrame); str.Color = C.WHITE; str.Thickness = 1
    local info = Instance.new("TextLabel")
    info.Name = "Info"; info.Size = UDim2.new(1, -20, 1, -10); info.Position = UDim2.new(0, 10, 0, 5)
    info.BackgroundTransparency = 1; info.TextColor3 = C.WHITE; info.Font = FONT_BODY; info.TextSize = 9
    info.TextXAlignment = Enum.TextXAlignment.Left; info.Parent = MatchaFrame
    MatchaFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            matchaDragging = true; matchaDragStart = input.Position; matchaStartPos = MatchaFrame.Position
        end
    end)
    MatchaFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then matchaDragging = false end
    end)
end

_G.FRH_MatchaDragLoop = UserInputService.InputChanged:Connect(function(input)
    if matchaDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and MatchaFrame then
        local delta = input.Position - matchaDragStart
        MatchaFrame.Position = UDim2.new(matchaStartPos.X.Scale, matchaStartPos.X.Offset + delta.X, matchaStartPos.Y.Scale, matchaStartPos.Y.Offset + delta.Y)
    end
end)

_G.FRH_MatchaLoop = RunService.RenderStepped:Connect(function(dt)
    if not MatchaFrame or not MatchaFrame.Parent then createMatchaFrame(); return end
    MatchaFrame.Visible = Config.Matcha.Enabled
    if Config.Matcha.Enabled then
        local fps = math.floor(1 / (dt > 0 and dt or 0.016))
        local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        local elapsed = math.floor(tick() - startTime)
        local mins = math.floor(elapsed / 60); local secs = elapsed % 60
        local info = MatchaFrame:FindFirstChild("Info")
        if info then
            local text = ""
            if Config.Matcha.ShowFPS then text = text .. "FPS: " .. fps .. "  " end
            if Config.Matcha.ShowPing then text = text .. "Ping: " .. ping .. "ms  " end
            text = text .. string.format("%02d:%02d", mins, secs)
            info.Text = text
        end
    end
end)

